# Default untuk build produksi (`npm run build`). Di-commit sengaja —
# ini deklarasi eksplisit, bukan kecelakaan: sampai backend/model asli
# tersambung, deploy publik jalan di atas mock. Begitu backend HF Space
# siap, ganti VITE_API_BASE_URL ke URL Space-nya dan VITE_USE_MOCKS=false.
VITE_API_BASE_URL=
VITE_USE_MOCKS=true
