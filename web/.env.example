# Salin file ini ke .env.local dan sesuaikan.

# Base URL backend FastAPI (Cloud Run, lihat CLAUDE.md utk deviasi dari
# HF Space asli). Diabaikan sepenuhnya selama VITE_USE_MOCKS=true.
# Backend asli yang live: https://fracture-api-607128796608.asia-southeast2.run.app
VITE_API_BASE_URL=http://localhost:8000

# true  = seluruh request API dicegat MSW, aplikasi jalan dengan data mock
#         tanpa backend sama sekali (default aman utk checkout baru --
#         tidak bergantung backend live).
# false = request diteruskan ke VITE_API_BASE_URL. Tidak ada kode lain yang
#         perlu diubah saat toggle ini — lihat src/main.tsx.
VITE_USE_MOCKS=true
